@startuml
title Сinemaabyss Container Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(User, "User", "A user of Сinemaabyss")

Container_Boundary(Cinemaabyss, "Сinemaabyss System") {
  Container(Database, "DatabaseSystem", "PostgreSQL", "Stores data")
  Container(Payments, "PaymentsSystem", "NodeJs", "handler of Payments")
  Container(Broker, "Message broker", "RabbitMQ", "Message broker")
  Container(Auth, "Auth", "NodeJs", "Authorization and authentication")
  Container(APIGateway, "APIGateway", "NodeJs", "APIGateway")
  Container(StreamService, "StreamService", "To present a streaming service")

}
  System_Ext(RecommendationSystem, "", "Recommendation System")


  Rel(User, APIGateway,"API")
  Rel(APIGateway, Auth,"API")
  Rel(APIGateway, Database,"TCP")
  Rel(APIGateway, Payments,"API")
  Rel(RecommendationSystem,Broker,"event")
  Rel(Broker,Database,"TCP")
  Rel(APIGateway,StreamService,"TCP")

@enduml